# On the Pi this is ~/services/nordic-trip/.env (for a backend run by hand: backend/.env). Never commit it.

# The chat answers through cli-bridge on the Pi (Claude Code on your plan, personal use).
# Keep ACCESS_CODE secret, since the backend is public.
ANTHROPIC_BASE_URL=http://127.0.0.1:8787
# Or with an API key instead:
# ANTHROPIC_API_KEY=sk-ant-...

# Code the chat asks for once per device. Required. Never put it on GitHub.
ACCESS_CODE=change-me

# Pages allowed to call this backend (comma separated). Your GitHub Pages origin, plus local testing.
ALLOWED_ORIGINS=https://xiao215.github.io,http://localhost:8001,http://127.0.0.1:8001

MODEL=claude-opus-5-5
EFFORT=low
PORT=8791

# Optional: the token scripts/plan.sh uses to upload a plan edited on a laptop. Left out, the backend makes one
# in data/admin.token on first start.
# ADMIN_TOKEN=
# Optional: a PRIVATE git repo the Pi's backup of the trip data is also pushed to.
# BACKUP_REMOTE=git@github.com:you/nordic-trip-data.git

# Abuse guards
DAILY_LIMIT=1000
