# Keeps a git history of the trip data on the Pi (scripts/pi-backup-plan.sh). Started by
# nordic-trip-backup.timer; installed by scripts/pi-update.sh.
[Unit]
Description=Nordic Trip 2027: back up the trip data on the Pi

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash %h/services/nordic-trip/repo/scripts/pi-backup-plan.sh
